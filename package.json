{
  "name": "hack-days-item-board",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:remote && wrangler deploy",
    "check": "node --check src/index.js && node --check public/app.js",
    "test": "node --test test/*.test.js",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs"
  },
  "devDependencies": {
    "wrangler": "4.130.0",
    "miniflare": "5.20260908.0-alpha"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
